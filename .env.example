# ================================================
# NAGRIKLENS V10 FINAL - LOCAL CONFIGURATION
# Copy to .env and enter secrets only in .env.
# ================================================

# Gemini via Google's OpenAI-compatible Chat Completions API.
# gemini-3.8-flash is the current stable Flash model for new projects; change only after checking model access.
# Leave blank to run retrieval/extract mode without generated explanations.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=45
LLM_RESPONSE_FORMAT=json_schema
LLM_MAX_RETRIES=1
LLM_CONTEXT_CHARS=24000

# Additional exact hostnames approved for server-side HTTPS fetching.
# Built-in defaults are also loaded from app/config.py.
# Do not use wildcards. Never add a host without verifying it first.
ALLOWED_SOURCE_HOSTS=

# Network and payload limits
REQUEST_TIMEOUT_SECONDS=20
MAX_SOURCE_BYTES=26214400
MAX_UPLOAD_BYTES=26214400
MAX_HTML_CHARS=2000000

# PDF page processing
DEFAULT_MAX_PAGES=10
MAX_PDF_PAGES=500
MAX_PROCESS_PAGES=500

# OCR fallback. Tesseract and the listed language packs must be installed separately.
OCR_ENABLED=1
OCR_LANGUAGES=eng+hin
MAX_OCR_PAGES=60
OCR_DPI=200
OCR_PAGE_TIMEOUT_SECONDS=60

# Linked PDFs are fetched only when include_linked_pdfs=true in the ingest request.
MAX_LINKED_PDFS=3

# Browser and request protections
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=20

# Optional controlled-demo access key. If set, send X-Nagriklens-API-Key.
NAGRIKLENS_API_KEY=

# Separate administrator key for source approval/rejection endpoints.
# If NAGRIKLENS_API_KEY is also set, both headers are required for admin POSTs.
NAGRIKLENS_ADMIN_KEY=

# Optional SQLite override. The default uses data/nagriklens_v10.sqlite3,
# or reuses an existing V9 database when no V10 database exists.
# NAGRIKLENS_DB_FILE=data/nagriklens_v10.sqlite3
